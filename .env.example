# Copy to .env.development/.env.preview/.env.production; never commit real values.
WISHLYN_ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=
# Only for a disposable/local development PostgreSQL server; never production.
DB_ALLOW_LOCAL_PLAINTEXT=false
# Optional trusted PEM CA when not using public certificate authorities.
DATABASE_CA_CERT=
# Only set after ingress is configured to replace, not forward, client copies.
# Allowed: x-vercel-forwarded-for, cf-connecting-ip, x-real-ip.
TRUSTED_CLIENT_IP_HEADER=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Opaque sessions need no JWT signing secret. Old JWT cookies/tokens are rejected.
